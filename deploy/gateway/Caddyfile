# WAMA store domain gateway: businesses' own domains (shop.theirname.com) → their online store on WAMA.
# Values come from /etc/caddy/gateway.env (written by setup.sh). No secrets live in this file.
{
	email {$ACME_EMAIL}
	# A certificate is made the first time a domain is visited, only if WAMA says the domain is connected
	on_demand_tls {
		ask {$APP_URL}/api/public/store-domain-check
	}
	servers {
		timeouts {
			read_body 30s
			read_header 10s
			idle 2m
		}
	}
}

# The gateway's own name (the CNAME target businesses use): a health check only
{$GATEWAY_HOSTNAME} {
	respond /healthz "ok" 200
	respond "WAMA store gateway" 200
}

# Every other name: a business's store
https:// {
	tls {
		on_demand
	}
	encode gzip zstd
	reverse_proxy {$APP_URL} {
		header_up Host {$APP_HOST}
		header_up X-Store-Domain {host}
		header_up X-Gateway-Key {$STORE_GATEWAY_KEY}
		transport http {
			tls_server_name {$APP_HOST}
		}
	}
	log {
		output file /var/log/caddy/stores.log {
			roll_size 20MiB
			roll_keep 5
		}
	}
}

# Plain http goes to https (Caddy does this on its own for the sites above)
