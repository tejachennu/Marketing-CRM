# WAMA CRM environment variables. Copy to .env.local and fill in.
# NEVER commit real values: this repository is public. .env.local is git-ignored.
#
# Easiest way to get the real values (for someone added to the Vercel project):
#   npm i -g vercel && vercel link && vercel env pull .env.local
# For local development, prefer a separate TEST Supabase project, not production.

# ── Supabase (required) ─────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Full access to the database: keep it secret.
SUPABASE_SERVICE_ROLE_KEY=

# Direct database connection, used by the app to add its own tables/columns
# (auto-migrations). Any one of these; optional for local work.
POSTGRES_URL_NON_POOLING=
POSTGRES_URL=
DATABASE_URL=

# ── App ─────────────────────────────────────────────────────────────────────
# Public address of the app, used in links sent on WhatsApp (e.g. https://your-domain)
NEXT_PUBLIC_APP_URL=
NEXT_PUBLIC_SUPPORT_EMAIL=
# Comma-separated emails that get the Super Admin console
SUPERADMIN_EMAILS=
# Protects the scheduled jobs (/api/cron/*)
CRON_SECRET=
# Workspace that receives website demo requests as leads (optional)
DEMO_REQUESTS_ORG_ID=
# Allows /api/seed in production (leave unset)
ENABLE_DEMO_SEED=

# ── WhatsApp through Meta (Cloud API) ───────────────────────────────────────
NEXT_PUBLIC_META_APP_ID=
NEXT_PUBLIC_META_CONFIG_ID=
NEXT_PUBLIC_META_CATALOG_CONFIG_ID=
NEXT_PUBLIC_META_ES_VERSION=
META_APP_SECRET=
META_SYSTEM_USER_TOKEN=
# Do not set this in production (it accepts unsigned webhooks)
META_WEBHOOK_ALLOW_UNSIGNED=
WHATSAPP_PROVIDER=facebook
WHATSAPP_GRAPH_API_VERSION=v21.0
WHATSAPP_API_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=
WHATSAPP_DEFAULT_PHONE=
WHATSAPP_PIN_SECRET=

# ── WhatsApp through Twilio (older workspaces) ──────────────────────────────
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_NUMBER=

# ── AI ──────────────────────────────────────────────────────────────────────
OPENAI_API_KEY=
# How AI usage is charged to workspaces' AI wallets
AI_PRICE_MARKUP=1.5
AI_USD_INR_RATE=88

# ── Billing (Razorpay) ──────────────────────────────────────────────────────
# Use TEST keys (rzp_test_…) anywhere but production
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Optional: pin a plan's Razorpay plan id. Left empty, the app finds or creates each plan itself.
RAZORPAY_PLAN_STARTER=
RAZORPAY_PLAN_GROWTH=
RAZORPAY_PLAN_PRO_1=
RAZORPAY_PLAN_PRO_2=
RAZORPAY_PLAN_PRO_3=
# Meta's price per WhatsApp message in rupees (message wallet, no markup). Empty = the prices in lib/message-prices.ts
META_PRICE_UTILITY_INR=
META_PRICE_AUTHENTICATION_INR=
META_PRICE_MARKETING_INR=
RAZORPAY_WEBHOOK_SECRET=

# ── WAMA's own WhatsApp number (sends booking messages for Starter workspaces) ──
# Leave these empty to use WAMA CRM's own number above (WHATSAPP_PHONE_NUMBER_ID, WHATSAPP_BUSINESS_ACCOUNT_ID,
# WHATSAPP_API_TOKEN); its webhook already reaches the platform workspace. Set them only for a separate number.
WAMA_SHARED_PHONE_NUMBER_ID=
WAMA_SHARED_WABA_ID=
WAMA_SHARED_ACCESS_TOKEN=
# Webhook /api/webhooks/wama-shared: the verify token you type in Meta, and the app secret if that
# number belongs to another Meta app (else META_APP_SECRET is used)
WAMA_SHARED_VERIFY_TOKEN=
WAMA_SHARED_APP_SECRET=
WAMA_SHARED_GRAPH_VERSION=

# ── Pop-up notifications on phones (Firebase Cloud Messaging) ──────────────
# The first four are in google-services.json (project_id, mobilesdk_app_id, current_key, project_number);
# the app reads them from /api/mobile/config. FIREBASE_SERVICE_ACCOUNT is the whole service account JSON
# (Firebase → Project settings → Service accounts → Generate new private key): secret, server only.
FIREBASE_PROJECT_ID=
FIREBASE_ANDROID_APP_ID=
FIREBASE_API_KEY=
FIREBASE_SENDER_ID=
FIREBASE_IOS_APP_ID=
FIREBASE_SERVICE_ACCOUNT=

# ── Sign in with Google / Apple (switched on in Supabase → Authentication → Providers) ──
# Which buttons the sign-in and sign-up pages show: "google", "google,apple", or empty for none
NEXT_PUBLIC_OAUTH_PROVIDERS=google

# ── Email ───────────────────────────────────────────────────────────────────
HOSTINGER_SMTP_HOST=
HOSTINGER_SMTP_PORT=
HOSTINGER_SMTP_USER=
HOSTINGER_SMTP_PASS=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=

# ── Other ───────────────────────────────────────────────────────────────────
V0_RUNTIME_URL=
